+// A loading host replaced by a same-tag host whose child is a Fragment: the
+// shape a `.tsx` render prop returning `<>{cond && <div />}…</>` takes when its
+// data arrives. The Fragment upgrades the host to Blocks, which adopts the
+// loading children by position; a Fragment row that renders nothing where a
+// loading child stood must remove that child and still get a place.
+function LoadingToFragment() {
+	const [data, setData] = useState<{ note?: string } | null>(null);
+	return createElement(
+		'section',
+		null,
+		createElement(
+			'button',
+			{
+				type: 'button',
+				'data-testid': 'load',
+				onClick: () => setData(data === null ? {} : { note: 'noted' }),
+			},
+			'load',
+		),
+		data === null
+			? createElement(
+					'div',
+					{ 'data-testid': 'panel' },
+					createElement('span', { 'data-testid': 'loading' }, 'Loading…'),
+				)
+			: createElement(
+					'div',
+					{ 'data-testid': 'panel' },
+					createElement(Fragment, {
+						children: [
+							data.note && createElement('p', { 'data-testid': 'note' }, data.note),
+							createElement('p', { 'data-testid': 'body' }, 'body'),
+						],
+					}),
+				),
+	);
+}
